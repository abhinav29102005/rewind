{
  "name": "rewind-guard",
  "displayName": "Rewind \u2014 AI Agent Guardrails & Approval",
  "description": "Enforced approval and undo layer for AI agents (Cursor, Claude, Antigravity, Windsurf). Intercepts destructive actions with instant rollback.",
  "version": "0.1.4",
  "publisher": "abhinav29102005",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "guardrails",
    "security",
    "approval",
    "cursor",
    "claude",
    "antigravity",
    "windsurf"
  ],
  "homepage": "https://github.com/abhinav29102005/rewind",
  "repository": {
    "type": "git",
    "url": "https://github.com/abhinav29102005/rewind"
  },
  "bugs": {
    "url": "https://github.com/abhinav29102005/rewind/issues"
  },
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rewind-guard-sidebar",
          "title": "Rewind Guard",
          "icon": "media/shield.svg"
        }
      ]
    },
    "views": {
      "rewind-guard-sidebar": [
        {
          "id": "rewind.pendingApprovals",
          "name": "Pending Action Approvals"
        },
        {
          "id": "rewind.auditLedger",
          "name": "Audit Ledger & Snapshots"
        },
        {
          "id": "rewind.statusOverview",
          "name": "Guard Status & Controls"
        }
      ]
    },
    "commands": [
      {
        "command": "rewind.openDashboard",
        "title": "Rewind: Open In-Editor Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "rewind.refresh",
        "title": "Refresh Approvals",
        "icon": "$(refresh)"
      },
      {
        "command": "rewind.listPending",
        "title": "Rewind: View Pending Approvals"
      },
      {
        "command": "rewind.approve",
        "title": "Rewind: Approve Action"
      },
      {
        "command": "rewind.deny",
        "title": "Rewind: Deny Action"
      },
      {
        "command": "rewind.approveItem",
        "title": "Approve",
        "icon": "$(check)"
      },
      {
        "command": "rewind.denyItem",
        "title": "Deny",
        "icon": "$(x)"
      },
      {
        "command": "rewind.inspectItem",
        "title": "Inspect Details",
        "icon": "$(info)"
      },
      {
        "command": "rewind.startControlPlane",
        "title": "Start Rewind Control Plane Server",
        "icon": "$(play)"
      },
      {
        "command": "rewind.verifyAudit",
        "title": "Verify Audit Log Hash Chain",
        "icon": "$(shield)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rewind.openDashboard",
          "when": "view == rewind.pendingApprovals",
          "group": "navigation@1"
        },
        {
          "command": "rewind.refresh",
          "when": "view == rewind.pendingApprovals",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "rewind.approveItem",
          "when": "view == rewind.pendingApprovals && viewItem == pendingApproval",
          "group": "inline@1"
        },
        {
          "command": "rewind.denyItem",
          "when": "view == rewind.pendingApprovals && viewItem == pendingApproval",
          "group": "inline@2"
        },
        {
          "command": "rewind.inspectItem",
          "when": "view == rewind.pendingApprovals && viewItem == pendingApproval",
          "group": "inline@3"
        }
      ]
    },
    "configuration": {
      "title": "Rewind Guardrails",
      "properties": {
        "rewind.apiUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "description": "Base URL of the Rewind Control Plane API server"
        },
        "rewind.apiToken": {
          "type": "string",
          "default": "",
          "description": "Optional Bearer API token (not required for local 127.0.0.1)"
        },
        "rewind.pollIntervalSeconds": {
          "type": "number",
          "default": 3,
          "description": "Polling interval in seconds to check for new pending approvals"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "build:vsix": "vsce package",
    "publish:marketplace": "vsce publish"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.1.3",
    "ts-loader": "^9.4.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.4"
  }
}