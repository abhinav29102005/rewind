{
  "name": "rewind-guard",
  "displayName": "Rewind Agent Guardrails",
  "description": "Approval UI and proxy integration for Rewind Agent Guardrails.",
  "version": "0.1.0",
  "publisher": "abhinav29102005",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rewind.approve",
        "title": "Rewind: Approve Action"
      },
      {
        "command": "rewind.deny",
        "title": "Rewind: Deny Action"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3",
    "ts-loader": "^9.4.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.4"
  }
}